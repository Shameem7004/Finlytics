model User {
    id          Int         @id @default(autoincrement())
    name        String
    email       String      @unique
    password    String
    role        Role        @default(VIEWER)
    isActive    Boolean     @default(true)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    records     Record[]
}

enum Role {
    ADMIN
    ANALYST
    VIEWER
}